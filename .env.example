TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, only when managers use a topic inside a Telegram group.
TELEGRAM_MESSAGE_THREAD_ID=

# Content admin: run node scripts/admin-credentials.mjs locally for credentials.
# Use server-only, sensitive Vercel env vars. Never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token scoped only to this repository, Contents: read/write.
CMS_GITHUB_TOKEN=
CMS_GITHUB_REPOSITORY=vbezia/obrii
# Production: main. Preview: a dedicated test branch (never main).
CMS_GITHUB_BRANCH=main
